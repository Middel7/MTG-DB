# Base de PRODUCTION (Render). Copier ce fichier en .env.prod et renseigner l'URL.
#
# Le .env.prod est git-ignoré : il ne doit JAMAIS être commité.
# Il est lu par update-prod.ps1, qui exporte DATABASE_URL avant de lancer le run.
#
# Render affiche parfois l'URL avec le préfixe postgres:// — que psycopg2 refuse.
# update-prod.ps1 le corrige automatiquement en postgresql://, mais autant la
# coller déjà sous la bonne forme.
DATABASE_URL=postgresql://UTILISATEUR:MOTDEPASSE@HOTE.frankfurt-postgres.render.com/BASE
